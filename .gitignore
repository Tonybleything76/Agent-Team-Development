logs/
out/
.pids/
sandbox/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.save
*~
.idea/
.vscode/

# Plain-text twins of working docs
*.plain.md

# Eval: keep baseline + latest, not every timestamped run
evals/results/run_*.json
evals/results/latest.json

# Harness artifacts
*.claudish-error
.gstack/
.design-work/
