# Secrets — never commit real credentials; copy .env.example to .env locally
.env
.env.*
!.env.example
*.key
*.pem
config.local.*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

