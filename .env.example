# Copy to .env and fill in. The CLI loads .env from the current directory; values already in the
# environment win. Dry-run (no key, no network) is the default.
# LLM_PROVIDER: dryrun | openrouter | openai | anthropic
LLM_PROVIDER=dryrun
# OpenRouter (recommended real provider): one key, any vendor's models, chosen per role.
# Model strings carry vendor and version, e.g. anthropic/claude-sonnet-5, openai/gpt-5-mini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Per-role overrides: OPENROUTER_MODEL_<ROLE> and OPENROUTER_EFFORT_<ROLE> (low|medium|high)
OPENROUTER_MODEL_PRE_SALES=
OPENROUTER_EFFORT=
OPENROUTER_EFFORT_STRATEGIST=
# Direct providers (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Where out/ and logs/ live (default: current directory; or pass --root)
HUMINLOOP_ROOT=.
ARTIFACT_DIR=out
LOG_DIR=logs
