# Copy to .env and fill in. .env is git-ignored and loaded by the CLI (never overrides real env).
# Dry-run (no key, no network) is the default; set LLM_PROVIDER to use a real model.
LLM_PROVIDER=dryrun            # dryrun | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Where out/ and logs/ live (default: current directory; or pass --root)
ADEPTLY_ROOT=.
ARTIFACT_DIR=out
LOG_DIR=logs
