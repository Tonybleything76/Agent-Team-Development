# Copy to .env and fill in. The CLI loads .env from the current directory; values already in the
# environment win. Dry-run (no key, no network) is the default.
# LLM_PROVIDER: dryrun | openrouter | openai | anthropic
LLM_PROVIDER=dryrun

# Recommended real provider: OpenRouter — one key, any vendor's models,
# and the model is picked per specialist role.
OPENROUTER_API_KEY=
# Default model for every role (package default: anthropic/claude-sonnet-5).
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Per-role overrides: OPENROUTER_MODEL_<ROLE_KEY_UPPERCASED>. Examples:
# OPENROUTER_MODEL_STRATEGIST=anthropic/claude-opus-5
# OPENROUTER_MODEL_PRE_SALES=openai/gpt-5
# OPENROUTER_MODEL_GOVERNANCE=openai/gpt-5-mini

# Direct-vendor providers (still supported).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Where out/ and logs/ live (default: current directory; or pass --root)
ADEPTLY_ROOT=.
ARTIFACT_DIR=out
LOG_DIR=logs
